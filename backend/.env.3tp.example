# 3TP connection
TPT_BASE_URL=https://3tp.tapasyatech.in
TPT_USERNAME=pranali@tapasyatech.in
TPT_PASSWORD=Tenant!@#
TPT_SYNC_ENABLED=1
TPT_TIMEOUT=10

# Adjust these to the authority names exposed by your 3TP deployment
TPT_ADMIN_AUTHORITY=TENANT_ADMIN
TPT_OPERATOR_AUTHORITY=CUSTOMER_USER

# Entity types used in 3TP
TPT_SITE_ASSET_TYPE=SITE
TPT_DEVICE_TYPE=AC
TPT_LOGIN_PATH=/api/auth/login
